# =============================================================================
# Ganpati Bapa Quiz Show - environment configuration
#
# You do NOT need to edit this file by hand. Upload the application, open
# https://your-domain.com/install and the wizard writes a real .env for you.
#
# This file is only a reference. Never commit a real .env to GitHub.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="Ganpati Bapa Quiz Show"

# production | local  (use production for a real event)
APP_ENV=production

# Never leave this true on a public site - it would show internal errors.
APP_DEBUG=false

# Full base URL of the installation, no trailing slash.
APP_URL=https://your-domain.com

APP_TIMEZONE=Asia/Kolkata

# gu = Gujarati, hi = Hindi, en = English
APP_LOCALE=gu

# Generated automatically by the installer. It encrypts the GitHub token.
# Changing it makes an already-stored GitHub token unreadable.
APP_KEY=

# Only set this if the app lives in a sub-folder and auto-detection fails,
# e.g. APP_BASE_PATH=/quiz
APP_BASE_PATH=

# --- Database ----------------------------------------------------------------
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ganpati_quiz
DB_USERNAME=
DB_PASSWORD=

# Optional: connect through a unix socket instead of host/port.
DB_SOCKET=

# --- Session -----------------------------------------------------------------
# Seconds of inactivity before an admin is signed out.
SESSION_LIFETIME=7200
